Options -Indexes
Options +FollowSymLinks

# -------------------------------------------------------
# PHP upload limits — increase to handle large screenshots
# -------------------------------------------------------
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 60
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 60
</IfModule>

RewriteEngine On

# Force HTTPS (uncomment on AWS after SSL is set up)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block access to sensitive files
<FilesMatch "(^\.env|\.env\..*|composer\.(json|lock)|\.git)">
    Require all denied
</FilesMatch>

# Block access to debug/test/migration scripts
<FilesMatch "(debug|test-|migrate_|seed_|check_|fix_|setup-|setup_|deploy_|create-manager)\.php$">
    Require all denied
</FilesMatch>

# Block direct access to sensitive API files
<Files "config.php">
    Require all denied
</Files>
<Files "session.php">
    Require all denied
</Files>
<Files "access-control.php">
    Require all denied
</Files>

# Set default charset
AddDefaultCharset UTF-8
